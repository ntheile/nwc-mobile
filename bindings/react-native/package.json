{
  "name": "@nwc-mobile/react-native",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "example"
  ],
  "description": "React Native bindings for the nwc-mobile Rust engine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ntheile/nwc-mobile.git"
  },
  "homepage": "https://github.com/ntheile/nwc-mobile",
  "author": "nwc-mobile contributors",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "src/*.ts",
    "lib/*.js",
    "lib/*.d.ts",
    "ios/NwcMobile.h",
    "ios/NwcMobileHost.h",
    "ios/NwcMobile.mm",
    "ios/generated",
    "android/build.gradle",
    "android/generated",
    "android/src/main",
    "native",
    "templates",
    "*.podspec",
    "NwcMobileFramework.xcframework",
    "react-native.config.js"
  ],
  "scripts": {
    "build": "node scripts/build-js.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "node scripts/generate.mjs",
    "generate:native": "node scripts/generate-native.mjs",
    "build:ios": "node scripts/build-ios.mjs",
    "build:android": "node scripts/build-android.mjs",
    "codegen": "node scripts/codegen.mjs",
    "prepack": "node scripts/verify-artifacts.mjs",
    "typecheck:example": "tsc -p example/tsconfig.json",
    "test:native:ios": "node scripts/test-native-ios.mjs",
    "test": "node scripts/build-js.mjs && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-3",
    "uniffi-bindgen-react-native": "0.31.0-3"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.85"
  },
  "codegenConfig": {
    "name": "NwcMobileSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "android": {
      "javaPackageName": "com.nwcmobile.reactnative"
    },
    "includesGeneratedCode": true
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
